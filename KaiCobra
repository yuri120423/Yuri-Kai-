local function selectTab(tab)
    for _, t in ipairs(tabs) do
        local active = (t == tab)
        if active and not t.Page.Visible then
            t.Page.Position = UDim2.fromOffset(24, 0)
            tween(t.Page, 0.45, { Position = UDim2.fromOffset(0, 0) })
        end
        t.Page.Visible = active
        tween(t.Button, 0.25, {
            BackgroundTransparency = active and 0 or 1,
            TextColor3 = active and C.Text or C.Muted,
        })
        tween(t.Bar, 0.35, { Size = UDim2.fromOffset(3, active and 18 or 0) }, Enum.EasingStyle.Back)
    end
end

