local draggingSlider = false

local function setValue(v)
    v = math.clamp(math.floor(v + 0.5), 0, 100)
    Hitbox.Value = v
    valueLabel.Text = tostring(v)
    local a = v / 100
    tween(fill, 0.12, { Size = UDim2.fromScale(a, 1) })
    tween(sKnob, 0.12, { Position = UDim2.fromScale(a, 0.5) })
    if v == 0 then restoreAll() end
end

local function fromInput(input)
    local rel = (input.Position.X - hit.AbsolutePosition.X) / hit.AbsoluteSize.X
    setValue(rel * 100)
end

bind(hit.InputBegan, function(input)
    if isPress(input) then
        draggingSlider = true
        fromInput(input)
        tween(sKnob, 0.15, { Size = UDim2.fromOffset(23, 23) }, Enum.EasingStyle.Back)
    end
end)
bind(UserInputService.InputChanged, function(input)
    if draggingSlider and isMove(input) then
        fromInput(input)
    end
end)
bind(UserInputService.InputEnded, function(input)
    if isPress(input) and draggingSlider then
        draggingSlider = false
        tween(sKnob, 0.15, { Size = UDim2.fromOffset(18, 18) })
    end
end)

