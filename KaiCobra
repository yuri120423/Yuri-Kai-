local function cleanup()
    Hitbox.Enabled = false
    restoreAll()
    Invis.Enabled = false
    ghostToken = ghostToken + 1
    dropSeat()
    pcall(clearInvis)
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    if gui then gui:Destroy() end
    fade:Destroy()
end
