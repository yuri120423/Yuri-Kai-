local function mount()
    local getters = {
        function() return gethui and gethui() end,
        function() return game:GetService("CoreGui") end,
        function() return LocalPlayer:WaitForChild("PlayerGui") end,
    }
    for _, get in ipairs(getters) do
        local okGet, container = pcall(get)
        if okGet and container then
            local okSet = pcall(function() gui.Parent = container end)
            if okSet and gui.Parent == container then
                return true
            end
        end
    end
    return false
end

