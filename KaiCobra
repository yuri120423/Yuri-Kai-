---------------- HELPERS ----------------
local connections = {}

local function bind(signal, fn)
    local c = signal:Connect(fn)
    connections[#connections + 1] = c
    return c
end

local function new(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function corner(obj, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r) }, obj)
end

local function tween(obj, time, goal, style, dir)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(time, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
        goal
    )
    t:Play()
    return t
end

local function hover(btn, normal, over)
    bind(btn.MouseEnter, function() tween(btn, 0.15, { BackgroundColor3 = over }) end)
    bind(btn.MouseLeave, function() tween(btn, 0.15, { BackgroundColor3 = normal }) end)
end

-- botao que "afunda" ao tocar e volta com mola
local function pressable(btn, amount)
    local s = btn:FindFirstChildOfClass("UIScale") or new("UIScale", { Scale = 1 }, btn)
    bind(btn.MouseButton1Down, function()
        tween(s, 0.1, { Scale = amount or 0.93 })
    end)
    bind(btn.MouseButton1Up, function()
        tween(s, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
    end)
    bind(btn.MouseLeave, function()
        tween(s, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
    end)
    return s
end

local function isPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch
end

local function isMove(i)
    return i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch
end

---------------- HITBOX ----------------
local Hitbox = { Enabled = false, Value = 0 }
local original = setmetatable({}, { __mode = "k" })

local function getCombatClient()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    return pg and pg:FindFirstChild("CombatClient")
end

local function restoreAll()
    for part, data in pairs(original) do
        if part.Parent then
            part.Size = data.Size
            part.Transparency = data.Transparency
            part.CanCollide = data.CanCollide
        end
        original[part] = nil
    end
end

local function applyHitbox()
    if CONFIG.RequireCombatClient and not getCombatClient() then
        restoreAll()
        return
    end

    local extra = Hitbox.Value * CONFIG.MaxExtra / 100

    for _, plr in ipairs(Players:GetPlayers()) do
        local skip = (plr == LocalPlayer)
        if CONFIG.IgnoreTeam and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
            skip = true
        end

        if not skip then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if hrp and hum and hum.Health > 0 then
                if not original[hrp] then
                    original[hrp] = {
                        Size = hrp.Size,
                        Transparency = hrp.Transparency,
                        CanCollide = hrp.CanCollide,
                    }
                end
                local base = original[hrp].Size
                hrp.Size = Vector3.new(base.X + extra, base.Y + extra, base.Z + extra)
                hrp.Transparency = CONFIG.PartTransparency
                hrp.CanCollide = false
            end
        end
    end
end

bind(RunService.Heartbeat, function()
    if Hitbox.Enabled and Hitbox.Value > 0 then
        applyHitbox()
    end
end)

local function inspectCombatClient()
    local cc = getCombatClient()
    if not cc then
        warn("[Yuri Kai] CombatClient nao encontrado em PlayerGui")
        notify("CombatClient nao encontrado")
        return
    end
    print(("[Yuri Kai] %s (%s)"):format(cc:GetFullName(), cc.ClassName))
    for _, d in ipairs(cc:GetDescendants()) do
        print(("  - %s [%s]"):format(d:GetFullName(), d.ClassName))
    end
    notify("Lista do CombatClient impressa no console")
end

---------------- INVISIVEL ----------------
-- Parte 1: voce se ve transparente (indicador, so na sua tela)
-- Parte 2: truque do assento que tenta esconder seu personagem dos outros
local Invis = { Enabled = false }
local fade = Instance.new("NumberValue")
local invisOriginal = setmetatable({}, { __mode = "k" })
local fadeTween
local ghostSeat
local ghostToken = 0
local GHOST_POS = Vector3.new(-25.95, 84, 3537.55) -- ponto distante usado no truque

local function applyInvis()
    local char = LocalPlayer.Character
    if not char then return end
    local f = fade.Value
    for _, d in ipairs(char:GetDescendants()) do
        if (d:IsA("BasePart") or d:IsA("Decal")) and d.Name ~= "HumanoidRootPart" then
            local o = invisOriginal[d]
            if o == nil then
                o = d.Transparency
                invisOriginal[d] = o
            end
            d.Transparency = o + (1 - o) * f
        end
    end
end

local function clearInvis()
    fade.Value = 0
    applyInvis()
    for k in pairs(invisOriginal) do
        invisOriginal[k] = nil
    end
end

bind(RunService.Heartbeat, function()
    if Invis.Enabled or fade.Value > 0 then
        applyInvis()
    end
end)

local function getCharParts()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local torso = char and (char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
    return char, hrp, torso
end

local function dropSeat()
    if ghostSeat then
        pcall(function() ghostSeat:Destroy() end)
        ghostSeat = nil
    end
end

local function goGhost(token)
    local char, hrp, torso = getCharParts()
    if not (char and hrp and torso) then
        notify("Personagem nao encontrado")
        return
    end

    local saved = hrp.CFrame
    char:MoveTo(GHOST_POS)
    task.wait(0.15)

    -- se desligou no meio do caminho, volta pro lugar
    if token ~= ghostToken or not Invis.Enabled then
        hrp.CFrame = saved
        return
    end

    local seat = Instance.new("Seat")
    seat.Name = "YuriKaiSeat"
    seat.Anchored = false
    seat.CanCollide = false
    seat.Transparency = 1
    seat.Position = GHOST_POS
    seat.Parent = workspace

    local weld = Instance.new("Weld")
    weld.Part0 = seat
    weld.Part1 = torso
    weld.Parent = seat

    task.wait()
    seat.CFrame = saved
    ghostSeat = seat
end

local function leaveGhost()
    local _, hrp = getCharParts()
    dropSeat()
    if hrp then
        task.wait(0.1)
        hrp.CFrame = hrp.CFrame + Vector3.new(0, 1, 0)
    end
end

-- ao renascer, reativa sozinho
bind(LocalPlayer.CharacterAdded, function()
    dropSeat()
    if Invis.Enabled then
        ghostToken = ghostToken + 1
        local token = ghostToken
        task.delay(1.5, function()
            if Invis.Enabled and token == ghostToken then
                goGhost(token)
            end
        end)
    end
end)

local function setInvisible(state)
    Invis.Enabled = state
    ghostToken = ghostToken + 1
    local token = ghostToken

    if fadeTween then fadeTween:Cancel() end
    fadeTween = TweenService:Create(
        fade,
        TweenInfo.new(CONFIG.InvisFadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
        { Value = state and CONFIG.GhostAlpha or 0 }
    )
    fadeTween.Completed:Connect(function(playbackState)
        if playbackState == Enum.PlaybackState.Completed and not Invis.Enabled then
            clearInvis()
        end
    end)
    fadeTween:Play()

    task.spawn(function()
        if state then
            goGhost(token)
        else
            leaveGhost()
        end
    end)
end

