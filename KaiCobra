-- Card generico (wrap segue o layout, card desliza dentro dele)
local function makeCard(page, order, height)
    local wrap = new("Frame", {
        Size = UDim2.new(1, 0, 0, height),
        BackgroundTransparency = 1,
        LayoutOrder = order,
    }, page)
    local card = new("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = C.Card,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, wrap)
    corner(card, 10)
    local cardStroke = new("UIStroke", { Color = C.Accent, Thickness = 1.3, Transparency = 1 }, card)
    return wrap, card, cardStroke
end

