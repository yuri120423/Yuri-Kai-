-- entrada em cascata dos itens
local introCards = { hCard, iCard }

local function playIntro()
    for i, card in ipairs(introCards) do
        card.Position = UDim2.new(0, -40, 0, 0)
        task.delay(0.2 + (i - 1) * 0.09, function()
            if card.Parent then
                tween(card, 0.6, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)
            end
        end)
    end
    for i, t in ipairs(tabs) do
        t.Scale.Scale = 0
        task.delay(0.15 + (i - 1) * 0.08, function()
            if t.Button.Parent then
                tween(t.Scale, 0.55, { Scale = 1 }, Enum.EasingStyle.Back)
            end
        end)
    end
end

local function openWindow()
    if isOpen then return end
    isOpen = true
    main.Visible = true
    if minimized then main.Position = FAB_CENTER end
    minimized = false

    local t1 = tween(fab, 0.2, { Size = UDim2.fromOffset(0, 0) })
    t1.Completed:Connect(function()
        if isOpen then fab.Visible = false end
    end)

    tween(main, 0.65, { Size = FULL, Position = lastPos }, Enum.EasingStyle.Back)
    playIntro()
end

local function closeWindow()
    if not isOpen then return end
    isOpen = false
    minimized = true
    lastPos = main.Position

    fab.Visible = true
    fab.Size = UDim2.fromOffset(0, 0)
    task.delay(0.2, function()
        if not isOpen and fab.Parent then
            tween(fab, 0.55, { Size = UDim2.fromOffset(44, 44) }, Enum.EasingStyle.Back)
        end
    end)

    local t2 = tween(main, 0.4, {
        Size = UDim2.fromOffset(0, 0),
        Position = FAB_CENTER,
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    t2.Completed:Connect(function()
        if not isOpen then main.Visible = false end
    end)
end

bind(fab.MouseButton1Click, openWindow)
bind(btnMin.MouseButton1Click, closeWindow)

bind(UserInputService.InputBegan, function(input, processed)
    if processed then return end
    if input.KeyCode == CONFIG.ToggleKey then
        if isOpen then closeWindow() else openWindow() end
    end
end)

