---------------- HELPERS ----------------
local connections = {}

local function bind(signal, fn)
    local c = signal:Connect(fn)
    connections[#connections + 1] = c
    return c
end

local function new(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function corner(obj, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r) }, obj)
end

local function tween(obj, time, goal, style, dir)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(time, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
        goal
    )
    t:Play()
    return t
end

local function hover(btn, normal, over)
    bind(btn.MouseEnter, function() tween(btn, 0.15, { BackgroundColor3 = over }) end)
    bind(btn.MouseLeave, function() tween(btn, 0.15, { BackgroundColor3 = normal }) end)
end

local function isPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch
end

local function isMove(i)
    return i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch
end

---------------- HITBOX ----------------
local Hitbox = { Enabled = false, Value = 0 }
local original = setmetatable({}, { __mode = "k" })

local function getCombatClient()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    return pg and pg:FindFirstChild("CombatClient")
end

local function restoreAll()
    for part, data in pairs(original) do
        if part.Parent then
            part.Size = data.Size
            part.Transparency = data.Transparency
            part.CanCollide = data.CanCollide
        end
        original[part] = nil
    end
end

local function applyHitbox()
    if CONFIG.RequireCombatClient and not getCombatClient() then
        restoreAll()
        return
    end

    local extra = Hitbox.Value * CONFIG.MaxExtra / 100

    for _, plr in ipairs(Players:GetPlayers()) do
        local skip = (plr == LocalPlayer)
        if CONFIG.IgnoreTeam and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
            skip = true
        end

        if not skip then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if hrp and hum and hum.Health > 0 then
                if not original[hrp] then
                    original[hrp] = {
                        Size = hrp.Size,
                        Transparency = hrp.Transparency,
                        CanCollide = hrp.CanCollide,
                    }
                end
                local base = original[hrp].Size
                hrp.Size = Vector3.new(base.X + extra, base.Y + extra, base.Z + extra)
                hrp.Transparency = CONFIG.PartTransparency
                hrp.CanCollide = false
            end
        end
    end
end

bind(RunService.Heartbeat, function()
    if Hitbox.Enabled and Hitbox.Value > 0 then
        applyHitbox()
    end
end)

local function inspectCombatClient()
    local cc = getCombatClient()
    if not cc then
        warn("[Yuri Kai] CombatClient nao encontrado em PlayerGui")
        notify("CombatClient nao encontrado")
        return
    end
    print(("[Yuri Kai] %s (%s)"):format(cc:GetFullName(), cc.ClassName))
    for _, d in ipairs(cc:GetDescendants()) do
        print(("  - %s [%s]"):format(d:GetFullName(), d.ClassName))
    end
    notify("Lista do CombatClient impressa no console")
end

